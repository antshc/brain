#!/usr/bin/env bash
# Block commits containing secrets (AWS keys, GitHub/Copilot tokens, etc.).
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found; install it (see DEVELOPMENT.md) or bypass with --no-verify." >&2
  exit 1
fi

exec gitleaks git --staged --redact --no-banner --verbose
