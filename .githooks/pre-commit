#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

sync_module() {
  local src="$REPO_ROOT/$1"
  local dest="$REPO_ROOT/$2"
  rsync -a --delete "$src" "$dest"
  git add "$dest"
}

sync_module "tools/src/modules/github/" "plugins/ralph/skills/fix/github/"
sync_module "tools/src/modules/git_worktree/" "plugins/ralph/skills/create-worktree/scripts/"
