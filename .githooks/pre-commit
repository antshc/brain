#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
SRC="$REPO_ROOT/tools/src/modules/github/"
DEST="$REPO_ROOT/plugins/ralph/skills/fix/github/"

rsync -a --delete --exclude='__pycache__/' --exclude='*.pyc' "$SRC" "$DEST"
git add "$DEST"

DEV_DEST="$REPO_ROOT/plugins/ralph/skills/dev/github/"
mkdir -p "$DEV_DEST"
rsync -a --delete --exclude='__pycache__/' --exclude='*.pyc' "$SRC" "$DEV_DEST"
git add "$DEV_DEST"

PR_STATE_SRC="$REPO_ROOT/tools/src/modules/github/pr_discussion_state.py"
PR_STATE_DEST="$REPO_ROOT/plugins/ralph/skills/address/scripts/pr_discussion_state.py"

rsync -a "$PR_STATE_SRC" "$PR_STATE_DEST"
git add "$PR_STATE_DEST"
